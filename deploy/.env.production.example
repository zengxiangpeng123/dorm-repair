DB_ROOT_PASSWORD=replace-with-strong-password
DB_USER=dorm_app
DB_PASSWORD=replace-with-strong-password
DB_NAME=dorm_repair
DB_USE_SSL=true
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=false
APP_DEMO=false
APP_AUTH_ALLOW_HEADER=false
APP_AUTH_LOGIN_MAX_FAILURES=5
APP_AUTH_LOGIN_BLOCK_MINUTES=15
APP_AUTH_SESSION_CLEANUP_MINUTES=60
APP_FILE_STORAGE=s3
APP_FILE_METADATA=mysql
APP_FILE_S3_ENDPOINT=https://s3.example.com
APP_FILE_S3_REGION=us-east-1
APP_FILE_S3_BUCKET=dorm-repair-private
# 静态凭据：Access/Secret 必须同时填写；生产更推荐 IAM Role，此时三项留空。
APP_FILE_S3_ACCESS_KEY=
APP_FILE_S3_SECRET_KEY=
APP_FILE_S3_SESSION_TOKEN=
# MinIO/部分 S3 兼容服务通常需要 true；AWS S3 保持 false。
APP_FILE_S3_PATH_STYLE=false
APP_FILE_CLEANUP_RETENTION_HOURS=24
APP_FILE_CLEANUP_BATCH_SIZE=100
APP_FILE_ALLOW_LEGACY_DEMO_URLS=false
AI_MODE=llm
AI_BASE_URL=https://ai-gateway.example.com/v1
AI_MODEL=raccoon/sn-deepseek-v4-1-flash-1017
AI_API_KEY=replace-with-secret
AI_TIMEOUT_S=20
SERVER_MAX_THREADS=200
SERVER_MAX_CONNECTIONS=8192
