# AI 定级服务配置模板。复制成 .env.local 再填，.env.local 已在 .gitignore 里，不会进仓库。
#
# 模式：
#   rules  只用关键词规则，毫秒级，断网/没钱/模型挂了都能跑（默认）
#   llm    规则当安全闸 + 真模型理解描述，秒级
AI_MODE=rules

# 真模型（任何 OpenAI 兼容的 /chat/completions 都行）
AI_BASE_URL=http://127.0.0.1:3065/v1
AI_MODEL=workbuddy/deepseek-v4.1-flash
AI_API_KEY=sk-在这里填你的密钥

# 单次调用最多等多久。实测这个模型冷启动 18 秒、热态 3.4 秒，
# 所以别设 800ms（Java 那边的默认值），否则永远走兜底。
AI_TIMEOUT_S=20
