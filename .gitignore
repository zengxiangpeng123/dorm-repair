# 依赖（原型零依赖；正式项目由 Maven / npm 管）
node_modules/
app/web/node_modules/

# 构建产物
target/
app/server/target/
dist/
__pycache__/
.venv/

# 演示数据库（M1 用内存；M2 起 MySQL，连接串走环境变量）
app/server/data/*.db
app/server/data/*.db-journal
app/server/data/*.db-wal
app/server/data/*.db-shm
app/server/data/uploads/

# 截图与临时文件
*.log
*.tmp
.DS_Store
Thumbs.db
app/web/screens/*.tmp.png

# 旧版 Node 实现的存档包很大，但它是交付物的一部分，故意入库
!docs/99_存档/*.zip

# Python
__pycache__/
.pytest_cache/
*.pyc

# 密钥：AI 服务的真实 api key 只放在本机 .env.local，绝不入库（仓库是 Public）
deploy/.env.production
deploy/prometheus/alertmanager.yml
deploy/certs/
deploy/backup/artifacts/

.env
.env.local
app/ai/.env
app/ai/.env.local

# Vite 构建残留与本地临时目录（本机安全策略不让清空 dist/，只能改出别目录兜着）
app/web/dist2/
app/web/dist3/
app/web/.tmp/
app/admin-web/.build-tmp/
app/student-web/.build-tmp/
app/worker-web/.build-tmp/
.preflight-test/

# Acceptance runtime evidence (contains environment-specific test data)
app/tests/acceptance/*-report.json
app/tests/acceptance/report.json
app/tests/acceptance/screenshots/
